[Unit]
Description=Cozy Midnight Diner 24/7 Interactive Stream Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/catcook
ExecStart=/bin/bash /home/ubuntu/catcook/stream/start_stream_linux.sh
Restart=always
RestartSec=10
Environment=DISPLAY=:99
StandardOutput=append:/home/ubuntu/catcook/logs/stream.log
StandardError=append:/home/ubuntu/catcook/logs/stream_error.log

[Install]
WantedBy=multi-user.target
